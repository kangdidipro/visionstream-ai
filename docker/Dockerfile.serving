FROM visionstream-ai:sprint-1

WORKDIR /app

# Install serving dependencies without modifying base requirements
COPY docker/requirements-serving.txt /app/docker/requirements-serving.txt
RUN pip install --no-cache-dir -r /app/docker/requirements-serving.txt

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
