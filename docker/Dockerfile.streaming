FROM visionstream-ai:sprint-1

WORKDIR /app

# Install GStreamer 1.0 packages, GObject introspection, and PyGObject build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libcairo2-dev \
    libgirepository-2.0-dev \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY docker/requirements-streaming.txt /app/docker/requirements-streaming.txt
RUN pip install --no-cache-dir -r /app/docker/requirements-streaming.txt

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python3", "-m", "src.streaming.main"]
